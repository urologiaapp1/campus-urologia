# ──────────────────────────────────────────────────────────────
# Campus Urología Sur — Variables de entorno
# Copia este archivo como .env.local y completa los valores.
# ──────────────────────────────────────────────────────────────

# ── SUPABASE (obligatorio) ─────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ⚠️ Privada: SOLO servidor / Vercel env vars. NUNCA en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── SITIO (opcional) ──────────────────────────────────────────
# URL base del sitio (para links en emails y certificados).
# En Vercel queda como: https://tu-dominio.vercel.app
NEXT_PUBLIC_SITE_URL=https://campus.urologiasur.cl

# ── EMAIL con Resend (opcional) ───────────────────────────────
# Gratis hasta 3.000 emails/mes. https://resend.com
# Si no se configura, la plataforma funciona sin notificaciones email.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Campus Urología Sur <no-reply@campus.urologiasur.cl>

# ── TUTOR IA (opcional) ───────────────────────────────────────
# Necesario para el tutor IA con RAG.
# OpenAI: embeddings (text-embedding-3-small) — muy económico
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Anthropic: respuestas del tutor (claude-haiku-4-5)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxx

# ── PAGOS con Stripe (opcional) ───────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
# Dashboard: Webhooks → Add endpoint → /api/payments/webhook
# Eventos: checkout.session.completed, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxx

# ── SIMULADOR DE PACIENTE (opcional) ──────────────────────────
# Clave institucional de Google AI Studio (gratuita).
# Si no se configura, el simulador queda deshabilitado para usuarios sin BYOK.
# Obtener en: https://aistudio.google.com → Get API key
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
